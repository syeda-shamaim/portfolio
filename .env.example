# Environment variables for local development
# Copy to `.env` and fill in values. Restart dev server: npm run dev

# Web3Forms — contact form emails (required for form to work)
# Get your key at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Formspree — alternative contact form (optional)
# VITE_FORMSPREE_ID=your_formspree_id_here

# --- Vercel deployment ---
# Add the same variables in Vercel Dashboard:
# Project → Settings → Environment Variables
# Name: VITE_WEB3FORMS_ACCESS_KEY
# Value: your Web3Forms access key
# Then redeploy.
